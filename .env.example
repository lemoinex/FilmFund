# Copier ce fichier en .env.local et renseigner les valeurs EN LOCAL uniquement.
# Ne jamais commiter de valeurs réelles. Ce fichier ne contient que des noms de variables.

# --- Supabase : exposées au navigateur (sans danger côté client, protégées par RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase : serveur uniquement (ne jamais préfixer par NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pour la CI (GitHub Actions), SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD et
# SUPABASE_PROJECT_ID se définissent dans les secrets GitHub, pas ici.
