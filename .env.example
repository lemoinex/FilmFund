# Copier ce fichier en .env.local et renseigner les valeurs EN LOCAL uniquement.
# Ne jamais commiter de valeurs réelles. Ce fichier ne contient que des noms de variables.

# --- Supabase : exposées au navigateur (sans danger côté client, protégées par RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase : serveur uniquement (ne jamais préfixer par NEXT_PUBLIC_) ---
SUPABASE_SECRET_KEY=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mode privé : serveur uniquement (ne jamais préfixer par NEXT_PUBLIC_) ---
# « true » réserve l'application à la liste ci-dessous ; toute autre valeur,
# ou l'absence de la variable, conserve le comportement habituel.
# Doit être activé en même temps que le verrou en base : voir docs/mode-prive.md.
PRIVATE_ADMIN_ONLY_MODE=
# Adresses autorisées, séparées par des virgules. Valeurs réelles dans
# .env.local et dans les variables Vercel, jamais dans ce fichier.
ALLOWED_ADMIN_EMAILS=

# Pour la CI (GitHub Actions), SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD et
# SUPABASE_PROJECT_ID se définissent dans les secrets GitHub, pas ici.

# --- Worker (dossier worker/, déployé sur Railway) ---
# Connexion au pooler Supabase en mode session, sous le rôle dédié
# filmfund_worker. Ces variables vivent dans Railway, pas dans .env.local ;
# PGPASSWORD est fixé par l'exploitant, jamais écrit dans le dépôt.
# Voir docs/worker.md.
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

# --- Lot 2 : à décommenter quand Supabase sera branché ---
# Base de données locale de la CLI Supabase (docker), jamais la base de production.
# SUPABASE_DB_URL=
