# Fins de ligne normalisées en LF dans le dépôt (Windows, Vercel, Railway et la CI Linux voient la même chose)
* text=auto eol=lf

# Scripts Windows : garder CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.woff binary
*.woff2 binary
